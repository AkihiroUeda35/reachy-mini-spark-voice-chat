# Service URLs and client defaults for local script entry points under samples/ and apps/
REACHY_HOST=reachy-mini.local
LLM_SERVER_URL=http://localhost:8010/v1
STT_SERVER_URL=http://localhost:8020/v1
TTS_SERVER_URL=http://localhost:8020/v1

# Local client credentials
CHAT_API_KEY=token-abc
ASR_API_KEY=local
TTS_API_KEY=local
TAVILY_API_KEY=

# LLM server
LLM_PROFILE=gemma4-31b
LLM_SERVED_MODEL_NAME=spark
LLM_PORT=8010
LLM_MAX_NUM_SEQS=1
LLM_MAX_MODEL_LEN=256000
LLM_MAX_NEW_TOKENS=30000
LLM_GPU_MEMORY_UTILIZATION=0.65
LLM_KV_CACHE_DTYPE=fp8

# LLM_PROFILE=gemma4-26b-a4b
# LLM_MAX_NUM_SEQS=2
# LLM_GPU_MEMORY_UTILIZATION=0.65
# LLM_PROFILE=gemma4-31b
# LLM_MAX_NUM_SEQS=1
# LLM_GPU_MEMORY_UTILIZATION=0.65
# LLM_PROFILE=qwen3.6-27b
# LLM_MAX_MODEL_LEN=262144
# LLM_MODEL=sakamakismile/Huihui-Qwen3.6-27B-abliterated-NVFP4-MTP
# LLM_SPECULATIVE_CONFIG={"method":"qwen3_5_mtp","num_speculative_tokens":4,"moe_backend":"triton"}


# OpenAI-compatible voice server
VOICE_SERVER_PORT=8020
STT_MODEL_ID=RoachLin/kotoba-whisper-v2.2-faster
STT_MODEL_SIZE=RoachLin/kotoba-whisper-v2.2-faster
STT_DEFAULT_LANGUAGE=ja
ASR_EXCLUDED_LANGUAGES=ru,es,fr
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
QWEN_TTS_API_PORT=8091
QWEN_TTS_GPU_MEMORY_UTILIZATION=0.1
TTS_DEFAULT_TASK_TYPE=CustomVoice
TTS_DEFAULT_LANGUAGE=Japanese
TTS_DEFAULT_VOICE=Ono_Anna
# Leave unset to use the backend default. Current Qwen deploy config defaults are stage0=0.9, subtalker=0.9, stage1=0.0.
TTS_TEMPERATURE=
TTS_ALPHA=0.3
TTS_BETA=0.7
# Stricter barge-in acceptance while Reachy is already speaking.
ASSISTANT_SPEAKING_INTERRUPT_MIN_VAD_MS=700
ASSISTANT_SPEAKING_INTERRUPT_MIN_CHARS=6
