# Service URLs and client defaults for local script entry points under samples/ and apps/
#REACHY_HOST=reachy-mini
LLM_SERVER_URL=http://localhost:8010/v1
STT_SERVER_URL=http://localhost:8020/v1
TTS_SERVER_URL=http://localhost:8020/v1
#HF_TOKEN=ht_
#TAVILY_API_KEY=tvly_

# Local client credentials
CHAT_API_KEY=token-abc
ASR_API_KEY=local
TTS_API_KEY=local

# LLM server
#LLM_PROFILE=gemma4-e4b
LLM_PROFILE=gemma4-26b-a4b
#LLM_PROFILE=gemma4-31b
#LLM_PROFILE=qwen3.6-27b
LLM_MAX_NUM_SEQS=8
LLM_MAX_NUM_BATCHED_TOKENS=8192
LLM_MAX_MODEL_LEN=200000
LLM_MAX_NEW_TOKENS=30000
LLM_GPU_MEMORY_UTILIZATION=0.55

# OpenAI-compatible voice server
VOICE_SERVER_PORT=8020
STT_MODEL_ID=large-v3-turbo
STT_MODEL_SIZE=large-v3-turbo
#STT_MODEL_ID=RoachLin/kotoba-whisper-v2.2-faster
#STT_MODEL_SIZE=RoachLin/kotoba-whisper-v2.2-faster
STT_DEFAULT_LANGUAGE=auto
ASR_EXCLUDED_LANGUAGES=ru,es,fr,id,pt,ko

TTS_BACKEND=tsukasa-speech
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
QWEN_TTS_GPU_MEMORY_UTILIZATION=0.1
TTS_DEFAULT_TASK_TYPE=CustomVoice
TTS_DEFAULT_LANGUAGE=Japanese
TTS_DEFAULT_VOICE=Ono_Anna
